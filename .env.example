# --- Database (local PostgreSQL managed by scripts/db.sh) ---
PGPORT=55432
PGUSER=aopx
PGPASSWORD=aopx
PGDATABASE=agentops
DATABASE_URL=postgresql+asyncpg://aopx:aopx@127.0.0.1:55432/agentops

# --- Collector ---
AGENTOPS_ENDPOINT=http://127.0.0.1:8000
# AGENTOPS_API_KEY=change-me          # if set, the SDK must send the same key

# --- LLM for the demo agent ---
# LLM_PROVIDER=google  -> native Gemini API (LLM_BASE_URL not used)
# LLM_PROVIDER=openai  -> any OpenAI-compatible server (vLLM, OpenAI, ...) at LLM_BASE_URL
LLM_PROVIDER=google
LLM_API_KEY=your-api-key
LLM_MODEL=gemini-flash-latest
LLM_BASE_URL=

# --- Demo fault injection (per tool call) ---
DEMO_TIMEOUT_RATE=0.15
DEMO_SLOW_RATE=0.10
